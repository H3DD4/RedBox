# Frontend environment variables
# All API calls go through the Express backend — do NOT set a direct HexStrike URL here.
#
# VITE_BACKEND_URL — leave empty for local dev (uses the Vite proxy at /api → localhost:3001).
# Set to an absolute origin ONLY when deploying the API on a separate host from the frontend,
# e.g. VITE_BACKEND_URL=https://api.redbox.example.com
VITE_BACKEND_URL=
