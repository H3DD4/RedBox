# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001

# ── Security ──────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=24h

# ── HexStrike MCP Server ──────────────────────────────────────────────────────
HEXSTRIKE_API_URL=http://127.0.0.1:8888

# ── Database ──────────────────────────────────────────────────────────────────
# Relative to backend/ directory at runtime, or an absolute path
DB_PATH=./data/redbox.db

# ── Storage ───────────────────────────────────────────────────────────────────
UPLOADS_DIR=./uploads

# ── Prompts ───────────────────────────────────────────────────────────────────
PROMPTS_DIR=./prompts

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (Vite dev server + production URL)
FRONTEND_URL=http://localhost:5173

# ── LLM resilience ────────────────────────────────────────────────────────────
LLM_MAX_ATTEMPTS_PER_PROVIDER=2
LLM_MAX_RETRY_DELAY_MS=30000
LLM_MAX_QUEUE_WAIT_MS=120000

# ── Neo4j Graph Database (optional) ───────────────────────────────────────────
# NEO4J_URI=bolt://localhost:9687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=your-password
# NEO4J_DATABASE=neo4j

# ── Optional: default admin credentials (used only for initial DB seed) ───────
# ADMIN_EMAIL=admin@redbox.io
# ADMIN_PASSWORD=redbox
